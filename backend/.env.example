ENVIRONMENT=development
API_V1_STR=/v1
PROJECT_NAME="AURA Virtual Fitting Room Gateway"

# Database
DATABASE_URL=postgresql+asyncpg://aura_user:aura_secret_pass@localhost:5432/aura_fitting_room

# Redis & Celery Broker
REDIS_URL=redis://localhost:6379/0

# MinIO Ephemeral Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aura_minio_admin
MINIO_SECRET_KEY=aura_minio_supersecret
MINIO_SECURE=false
MINIO_BUCKET_NAME=aura-ephemeral-captures
STORAGE_TTL_MINUTES=15

# Security & CORS
JWT_SECRET_KEY=aura_kiosk_secret_jwt_key_2026_x99
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
